# Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GOOGLE_API_KEY=your_api_key_here
# Optional fallback keys, comma-separated, tried in order when a key hits a
# rate limit. Limits are per Google Cloud project, so keys from the same
# project add nothing.
GOOGLE_API_KEYS=

# --- Model selection ---
# Both must be Gemini model names (list them with: python -m src.manage list-models).
CHAT_MODEL=models/gemini-2.5-flash
CLASSIFY_MODEL=models/gemini-3.1-flash-lite
# Articles per classification request (ADR-018).
CLASSIFY_BATCH_SIZE=20

# --- Sync protection ---
# Machine key for the scheduled (cron) sync. Unset = sync disabled.
# Generate long random values with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_KEY=change_me

# --- Dashboard logins ---
# Signs login tokens. At least 32 characters. Changing it signs everyone out.
SESSION_SECRET=change_me_to_a_long_random_value

# --- Database (Neon Postgres + pgvector, see ADR-017) ---
# Neon console -> your project -> Connect -> copy the pooled connection string.
# Contains a password: keep it in .env only, never commit it.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- CORS ---
# Comma-separated list of origins allowed to call the API.
# Defaults to "*" for local development. Set this to your real dashboard
# origin before deploying.
ALLOWED_ORIGINS=*

# Optional: HuggingFace Token for faster model downloads
# HF_TOKEN=your_token_here
